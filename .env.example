# ============================================
# MediCheck — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (DeepSeek — mặc định) ----
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ---- LLM Configuration (OpenAI, KHONG dung trong deployment hien tai) ----
# Khong xuat hien trong bien moi truong Render that - de trong, chi can neu ban
# tu doi provider LLM cuc bo.
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# DB chinh (users, medications, products, interaction_checks, ...) - Postgres bat
# buoc (local hoac hosted deu duoc, khong con ho tro SQLite); điền connection
# string production thật, không dùng giá trị mẫu bên duoi. Nhanh production la
# connection string rieng, chi dung luc deploy, khong chia se rong.
# Driver ghi ro +psycopg2 - SQLAlchemy >=2.1 doi driver mac dinh cho URL tran
# "postgresql://" sang psycopg (v3, chua co trong requirements.txt).
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medicheck

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Authentication ----
SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
ENABLE_DEMO_ACCOUNTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Cac ten tuong thich: SMTP_FROM_EMAIL, SMTP_FROM_NAME, SMTP_USE_TLS
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY_SECONDS=1
# Gmail API (OAuth) - dung thay SMTP tren host chan outbound SMTP (vd Render).
# Khi GMAIL_OAUTH_REFRESH_TOKEN co gia tri, backend gui mail qua Gmail API (HTTPS)
# thay vi SMTP. Xem docs/04_KyThuat/gmail-api-setup.md de lay 3 gia tri nay.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
